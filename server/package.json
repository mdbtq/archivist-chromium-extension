{
  "name": "archivist-server",
  "version": "1.0.0",
  "description": "Local archiving server for the Archivist browser extension",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "install-host": "node ../host/install-host.js",
    "uninstall-host": "node ../host/install-host.js --uninstall"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
